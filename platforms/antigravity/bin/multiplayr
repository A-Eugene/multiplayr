#!/usr/bin/env bash
# multiplayr client: sign-in, joining topics, the wake stream and a stdio MCP proxy. Needs bash and curl.
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/multiplayr"
SERVER="${MULTIPLAYR_SERVER:-$(cat "$CONFIG_DIR/server" 2>/dev/null || echo https://multiplayr.aeugene.me)}"
TOKEN_FILE="$CONFIG_DIR/token"
# A nested agent inherits its parent's id variable, so the innermost platform's variable wins.
if [[ -n ${CODEX_THREAD_ID:-} ]]; then DETECTED=CODEX
elif [[ -n ${ANTIGRAVITY_CONVERSATION_ID:-} ]]; then DETECTED=ANTIGRAVITY
else DETECTED=CLAUDE_CODE; fi
PLATFORM="${MULTIPLAYR_PLATFORM:-$DETECTED}"
case $PLATFORM in
  CODEX) SESSION="${MULTIPLAYR_SESSION:-${CODEX_THREAD_ID:-}}" ;;
  ANTIGRAVITY) SESSION="${MULTIPLAYR_SESSION:-${ANTIGRAVITY_CONVERSATION_ID:-}}" ;;
  *) SESSION="${MULTIPLAYR_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}" ;;
esac
# Agents strip most variables from MCP servers, so state lives under HOME.
STATE_DIR="$HOME/.cache/multiplayr"
HOST_CHECK_S=30
LOGIN_POLL_S=3
RECONNECT_S=10
RELEASE_URL=https://raw.githubusercontent.com/A-Eugene/multiplayr/main
UPDATE_CHECK_MIN=10
# The version whose hooks.json the running code expects. Raise it whenever hooks.json changes, so sessions with older hooks are told to restart.
HOOKS_VERSION=0.4.20
PLUGIN_ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
plugin_version() {
  cat "$1"/.claude-plugin/plugin.json "$1"/.codex-plugin/plugin.json "$1"/plugin.json 2>/dev/null | sed -nE 's/.*"version" *: *"([^"]*)".*/\1/p' | head -1
}
VERSION=$(plugin_version "$PLUGIN_ROOT")
# True when version $1 is newer than version $2. An empty version counts as oldest.
newer() { [[ $1 != "${2:-0}" && $(printf '%s\n%s\n' "${2:-0}" "$1" | sort -V | tail -1) == "$1" ]]; }
# The version the hooks and the CLI on PATH run now, which an update changes while this process keeps running.
client_version() {
  local target
  target=$(readlink -f "$HOME/.local/bin/multiplayr" 2>/dev/null)
  target=$(plugin_version "${target%/bin/multiplayr}")
  printf '%s' "${target:-$VERSION}"
}

die() { echo "multiplayr: $*" >&2; exit 1; }
token() { cat "$TOKEN_FILE" 2>/dev/null || die "not signed in, run: multiplayr login"; }
json_escape() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}; printf '%s' "${s//$'\n'/\\n}"; }
json_field() { sed -nE "s/.*\"$1\" *: *\"([^\"]*)\".*/\1/p"; }

# Calls the server as this device and session. Prints the body, fails on HTTP errors.
api() {
  local method=$1 path=$2; shift 2
  local out status bearer
  bearer=$(token) || exit 1
  out=$(curl -sS -X "$method" -w '\n%{http_code}' -H "Authorization: Bearer $bearer" -H "X-Multiplayr-Session: $SESSION" -H "X-Multiplayr-Version: $(client_version)" "$@" "$SERVER$path") || die "server unreachable"
  status=${out##*$'\n'}
  out=${out%$'\n'*}
  [[ $status == 2* ]] || die "$out"
  printf '%s\n' "$out"
}

need_session() { [[ -n $SESSION ]] || die "no session id (set MULTIPLAYR_SESSION)"; }

# Revokes this machine's token on the server, when it has one.
revoke_token() {
  [[ -f $TOKEN_FILE ]] && curl -sS -m 10 -o /dev/null -X POST -H "Authorization: Bearer $(cat "$TOKEN_FILE")" "$SERVER/api/device/logout" 2>/dev/null
  rm -f "$TOKEN_FILE"
}

cmd_login() {
  local start url poll status
  start=$(curl -sS -X POST -H 'content-type: application/json' -d "{\"name\":\"$(json_escape "$(hostname)")\"}" "$SERVER/api/device/start") || die "server unreachable"
  url=$(json_field url <<<"$start"); poll=$(json_field poll <<<"$start")
  [[ -n $poll ]] || die "$start"
  echo "Open $url and approve"
  while true; do
    sleep "$LOGIN_POLL_S"
    out=$(curl -sS -X POST -w '\n%{http_code}' -H 'content-type: application/json' -d "{\"poll\":\"$poll\"}" "$SERVER/api/device/poll") || continue
    status=${out##*$'\n'}
    case $status in
      200) revoke_token; mkdir -p "$CONFIG_DIR"; (umask 077; printf '%s' "${out%$'\n'*}" >"$TOKEN_FILE"); echo "Signed in"; return ;;
      410) echo "Link expired, run login again"; exit 1 ;;
    esac
  done
}

# The session's title as Claude Code stores it in the transcript, or nothing.
session_title() {
  [[ $PLATFORM == CLAUDE_CODE && -n $SESSION ]] || return 0
  cat "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$SESSION.jsonl" 2>/dev/null | grep '"type":"custom-title"' | tail -1 | json_field customTitle
}

# The session title without a leading [tag], else the working folder, as a valid agent name.
default_name() {
  local title
  title=$(session_title | sed -E 's/^\[[^]]*\] *//')
  printf '%s' "${title:-$(basename "$PWD")}" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//' | cut -c1-40 | sed -E 's/-+$//'
}

cmd_join() {
  need_session
  local project=${1:?usage: multiplayr join <project> [name]}
  local name=${2:-${MULTIPLAYR_NAME:-$(default_name)}}
  api POST /api/agent/join -H 'content-type: application/json' \
    -d "{\"project\":\"$(json_escape "$project")\",\"name\":\"$(json_escape "$name")\",\"platform\":\"$PLATFORM\",\"model\":\"$(json_escape "${MULTIPLAYR_MODEL:-}")\"}"
  [[ $PLATFORM == CODEX ]] && start_relay
  mkdir -p "$STATE_DIR" && touch "$STATE_DIR/joined-$SESSION"
  return 0
}

cmd_topic() {
  need_session
  api POST /api/agent/topic -H 'content-type: application/json' -d "{\"topic\":\"$(json_escape "${1:?usage: multiplayr topic <topic>}")\"}"
}

# Leaves one topic. Leaving the whole project needs --project, which an agent runs only after its owner confirms.
cmd_leave() {
  need_session
  local topic=${1:?usage: multiplayr leave <topic> | leave --project}
  [[ $topic == --project ]] && topic=
  api POST /api/agent/leave -H 'content-type: application/json' -d "{\"topic\":\"$(json_escape "$topic")\"}"
}

cmd_rename() {
  need_session
  api POST /api/agent/rename -H 'content-type: application/json' -d "{\"name\":\"$(json_escape "${1:?usage: multiplayr rename <name>}")\"}"
}

# Calls one MCP tool and prints its text.
call_tool() {
  api POST /api/mcp -H 'content-type: application/json' \
    -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$1\",\"arguments\":${2:-{\}}}}" |
    sed -n 's/.*"text":"\(.*\)"}\].*/\1/p' | sed 's/\\n/\n/g; s/\\"/"/g'
}

cmd_status() { need_session; call_tool status; }

cmd_upload() {
  need_session
  local topic=${1:?usage: multiplayr upload <topic> <file> [text]} file=${2:?usage: multiplayr upload <topic> <file> [text]}
  [[ -f $file ]] || die "no file $file"
  api POST /api/agent/upload -F "topic=$topic" -F "file=@$file" -F "text=${3:-}"
}

cmd_download() {
  local id=${1:?usage: multiplayr download <file id> <path>} dest=${2:?usage: multiplayr download <file id> <path>}
  curl -sSf -H "Authorization: Bearer $(token)" -o "$dest" "$SERVER/api/files/$id" || die "download failed"
  echo "saved $dest"
}

# Prints one line per wake. Reconnects after network errors and exits when the session has joined no project or is signed out.
# With --once it exits after the first line, which is how a background command wakes an agent that has no monitor.
cmd_watch() {
  local once=${1:-} status
  need_session
  while true; do
    status=
    while IFS= read -r line; do
      case $line in
        data:*) echo "${line#data: }"; [[ $once == --once ]] && { kill "$!" 2>/dev/null; exit 0; } ;;
        status:*) status=${line#status:} ;;
      esac
    done < <(curl -sN -w '\nstatus:%{http_code}\n' -H "Authorization: Bearer $(cat "$TOKEN_FILE" 2>/dev/null)" -H "X-Multiplayr-Session: $SESSION" -H "X-Multiplayr-Version: $VERSION" "$SERVER/api/agent/watch")
    [[ $status == 204 || $status == 4* ]] && exit 0
    sleep "$RECONNECT_S"
  done
}

# Claude Code wake: an asyncRewake hook, where exit code 2 starts a turn with stderr as its prompt. Exits silently in a session that has joined no project.
cmd_listen() {
  local session line pidfile
  session=$(json_field session_id)
  [[ -n $session ]] && SESSION=$session
  pidfile="$STATE_DIR/listen-$SESSION.pid"
  kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null && return
  mkdir -p "$STATE_DIR" && echo $$ >"$pidfile"
  line=$(cmd_watch --once)
  [[ -n $line ]] || return
  echo "$line" >&2
  exit 2
}

# Turn hooks: reports whether this session's agent is thinking or idle. A running turn is reported at most once a minute.
# Installs a newer published version in the background, at most once per UPDATE_CHECK_MIN on this machine.
check_update() {
  local marker="$STATE_DIR/update-check"
  [[ -n $(find "$marker" -mmin -"$UPDATE_CHECK_MIN" 2>/dev/null) ]] && return 0
  mkdir -p "$STATE_DIR" && touch "$marker"
  self_update "$PLUGIN_ROOT"
}

# For a joined Claude Code session: the new rules once after an update, and on each prompt a reminder to restart while its hooks are older than this version needs.
hook_notes() {
  local event=$1 start rules context= message=
  [[ -f $STATE_DIR/joined-$SESSION ]] || return 0
  start=$(cat "$STATE_DIR/root-$SESSION" 2>/dev/null)
  start=${start:+$(plugin_version "$start")}
  rules=$(cat "$STATE_DIR/rules-$SESSION" 2>/dev/null)
  rules=${rules:-$start}
  if newer "$VERSION" "$rules"; then
    context="Multiplayr updated to $VERSION. Follow these rules from now on:"$'\n\n'"$(cat "$PLUGIN_ROOT/instructions.md")"
    printf '%s' "$VERSION" >"$STATE_DIR/rules-$SESSION"
  fi
  if [[ $event == UserPromptSubmit ]] && newer "$HOOKS_VERSION" "$start"; then
    message="Multiplayr $VERSION needs newer hooks than this session loaded (${start:-before 0.4.18}). Restart this session to load them: exit, then run claude --resume."
  fi
  [[ -n $context || -n $message ]] || return 0
  local out="{"
  [[ -n $message ]] && out+="\"systemMessage\":\"$(json_escape "$message")\""
  [[ -n $context ]] && out+="${message:+,}\"hookSpecificOutput\":{\"hookEventName\":\"$event\",\"additionalContext\":\"$(json_escape "$context")\"}"
  printf '%s}\n' "$out"
}

cmd_state() {
  local state=${1:?state} session mark input host
  input=$(cat)
  session=$(json_field session_id <<<"$input")
  [[ -n $session ]] || session=$(json_field conversationId <<<"$input")
  [[ -n $session ]] && SESSION=$session
  if [[ $PLATFORM == ANTIGRAVITY ]]; then
    if [[ -n $SESSION && $state == thinking ]]; then
      host=$(host_pid)
      mkdir -p "$STATE_DIR" && printf '%s' "$SESSION" >"$STATE_DIR/host-$host.session"
    fi
    echo '{}'
  fi
  [[ -n $SESSION && -f $TOKEN_FILE ]] || return 0
  [[ $state == thinking ]] && check_update
  [[ $PLATFORM == CLAUDE_CODE ]] && hook_notes "$(json_field hook_event_name <<<"$input")"
  mark="$STATE_DIR/thinking-$SESSION"
  if [[ $state == thinking ]]; then
    [[ -n $(find "$mark" -mmin -1 2>/dev/null) ]] && return 0
    mkdir -p "$STATE_DIR" && touch "$mark"
  else
    rm -f "$mark"
  fi
  local body="{\"state\":\"$state\"}"
  # A permission prompt or a question dialog waits for the owner, who gets a push with its text.
  case $(json_field notification_type <<<"$input") in
    permission_prompt|elicitation_dialog) body="{\"state\":\"$state\",\"approval\":\"$(json_escape "$(json_field message <<<"$input")")\"}" ;;
  esac
  curl -sS -m 3 -o /dev/null -X POST -H 'content-type: application/json' -H "Authorization: Bearer $(cat "$TOKEN_FILE")" -H "X-Multiplayr-Session: $SESSION" -H "X-Multiplayr-Version: $(client_version)" --data "$body" "$SERVER/api/agent/state" 2>/dev/null || true
}

# Stdio MCP server: forwards each JSON-RPC line to the server with this device's token and session id.
cmd_mcp() {
  while IFS= read -r line; do
    local id reply session=$SESSION
    [[ -n $session ]] || session=$(sed -nE 's/.*"thread_id" *: *"([^"]*)".*/\1/p' <<<"$line")
    [[ -n $session ]] || session=$(cat "$STATE_DIR/host-$(host_pid).session" 2>/dev/null)
    id=$(sed -nE 's/.*"id" *: *([0-9]+|"[^"]*").*/\1/p' <<<"$line")
    reply=$(curl -sS -X POST -H 'content-type: application/json' -H "Authorization: Bearer $(cat "$TOKEN_FILE" 2>/dev/null)" \
      -H "X-Multiplayr-Session: $session" -H "X-Multiplayr-Version: $(client_version)" --data-binary "$line" "$SERVER/api/mcp" 2>/dev/null)
    if [[ $reply == \{* ]]; then
      printf '%s\n' "$reply"
    elif [[ -n $id ]]; then
      local message
      message=$(json_escape "${reply:-server unreachable}")
      printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32000,"message":"multiplayr: %s"}}\n' "$id" "$message"
    fi
  done
}

# Prints the pid of the agent process that started this one: the nearest ancestor that is not a shell.
host_pid() {
  local pid=$PPID comm
  while (( pid > 1 )); do
    comm=$(ps -o comm= -p "$pid")
    case ${comm##*/} in sh|bash|dash|zsh|env) pid=$(ps -o ppid= -p "$pid" | tr -d ' ') ;; *) break ;; esac
  done
  echo "$pid"
}

# True while Codex holds this thread's writer lock, which it releases when it unloads the thread.
thread_open() {
  local lock="${CODEX_HOME:-$HOME/.codex}/thread-writer-locks/$SESSION.lock"
  [[ -f $lock ]] && { ! command -v flock >/dev/null || ! flock -n -s "$lock" true 2>/dev/null; }
}

# Codex wake: queues each wake line into this thread while the thread is open and the session is in a project.
cmd_relay() {
  need_session
  cmd_watch | while IFS= read -r line; do codex queue --thread "$SESSION" --message "$line" >/dev/null 2>&1; done &
  local listener=$!
  sleep "$HOST_CHECK_S"
  while kill -0 "$listener" 2>/dev/null && thread_open; do sleep "$HOST_CHECK_S"; done
  kill 0
}

# Starts one relay per Codex thread, detached from the hook.
start_relay() {
  local pidfile="$STATE_DIR/relay-$SESSION.pid"
  mkdir -p "$STATE_DIR"
  kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null && return
  local detach=; command -v setsid >/dev/null && detach=setsid
  MULTIPLAYR_SESSION=$SESSION $detach "$0" relay </dev/null >/dev/null 2>&1 &
  echo $! >"$pidfile"
}

# The newest installed plugin folder for this platform, or nothing.
installed_root() {
  local cache
  case $PLATFORM in
    CLAUDE_CODE) cache="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache/multiplayr/multiplayr" ;;
    CODEX) cache="${CODEX_HOME:-$HOME/.codex}/plugins/cache/multiplayr/multiplayr" ;;
    ANTIGRAVITY)
      local dir="${GEMINI_CONFIG_DIR:-$HOME/.gemini/config}/plugins/multiplayr"
      [[ -d $dir ]] && printf '%s' "$dir"
      return ;;
    *) return ;;
  esac
  local root
  root=$(ls -d "$cache"/*/ 2>/dev/null | sort -V | tail -1)
  printf '%s' "${root%/}"
}

# The newest installed version across the platforms' caches, or nothing.
newest_install() {
  local dir version best= best_version=
  for dir in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/plugins/cache/multiplayr/multiplayr/*/ "${CODEX_HOME:-$HOME/.codex}"/plugins/cache/multiplayr/multiplayr/*/ "${GEMINI_CONFIG_DIR:-$HOME/.gemini/config}"/plugins/multiplayr/; do
    [[ -x ${dir}bin/multiplayr ]] || continue
    version=$(plugin_version "${dir%/}")
    if [[ -z $best ]] || [[ $version != "$best_version" && $(printf '%s\n%s\n' "$best_version" "$version" | sort -V | tail -1) == "$version" ]]; then
      best=${dir%/}
      best_version=$version
    fi
  done
  printf '%s' "$best"
}

# Points multiplayr on PATH at the newest installed version, or at the given root when none is installed. The hooks run that link.
link_newest() {
  local target link="$HOME/.local/bin/multiplayr"
  target=$(newest_install)
  [[ -n $target ]] || target=$1
  [[ -x $target/bin/multiplayr ]] || return 0
  mkdir -p "$HOME/.local/bin" && ln -s "$target/bin/multiplayr" "$link.$$" && mv -Tf "$link.$$" "$link"
}

# Downloads the latest published Antigravity plugin folder and installs it with agy.
update_antigravity() {
  local agy tmp rc
  agy=$(command -v agy 2>/dev/null || echo "$HOME/.local/bin/agy")
  [[ -x $agy ]] || return 1
  tmp=$(mktemp -d) || return 1
  curl -sSfL https://github.com/A-Eugene/multiplayr/archive/refs/heads/main.tar.gz | tar -xz -C "$tmp" &&
    "$agy" plugin install "$tmp/multiplayr-main/platforms/antigravity" >/dev/null
  rc=$?
  rm -rf "$tmp"
  return "$rc"
}

# Installs the published plugin now, points multiplayr on PATH at it, and prints its rules and this session's status.
# Hooks run from the version the session started with.
cmd_reload() {
  case $PLATFORM in
    CLAUDE_CODE) claude plugin marketplace update multiplayr >/dev/null && claude plugin update multiplayr@multiplayr >/dev/null || die "update failed" ;;
    CODEX) codex plugin marketplace upgrade multiplayr >/dev/null && codex plugin add multiplayr@multiplayr >/dev/null || die "update failed" ;;
    ANTIGRAVITY) update_antigravity || die "update failed" ;;
    *) die "unsupported platform $PLATFORM" ;;
  esac
  local root
  root=$(installed_root)
  [[ -f $root/instructions.md ]] || die "no installed plugin found"
  link_newest "$root"
  [[ -n $SESSION ]] && mkdir -p "$STATE_DIR" && plugin_version "$root" >"$STATE_DIR/rules-$SESSION"
  cat "$root/instructions.md"
  echo
  "$root/bin/multiplayr" status
}

# The installed version, the version this session's hooks run, and the rules version multiplayr reload loaded.
cmd_version() {
  local installed hooks rules
  installed=$(installed_root)
  installed=${installed:+$(plugin_version "$installed")}
  hooks=$(cat "$STATE_DIR/root-$SESSION" 2>/dev/null)
  hooks=${hooks:+$(plugin_version "$hooks")}
  rules=$(cat "$STATE_DIR/rules-$SESSION" 2>/dev/null)
  echo "Installed: ${installed:-$VERSION}"
  echo "This session's hooks: ${hooks:-unknown, started before 0.4.18}"
  echo "This session's rules: ${rules:-${hooks:-unknown}}"
}

# SessionStart hook: puts this script on PATH, records the session id for the MCP server and, for a joined session, prints the rules and unread counts.
# Installs the published plugin when it is newer than this one, in the background. The new version loads in the next session.
self_update() {
  local root=$1 manifest update
  case $PLATFORM in
    CLAUDE_CODE) manifest=claude-code/.claude-plugin/plugin.json; update='claude plugin marketplace update multiplayr && claude plugin update multiplayr@multiplayr' ;;
    CODEX) manifest=codex/.codex-plugin/plugin.json; update='codex plugin marketplace upgrade multiplayr && codex plugin add multiplayr@multiplayr' ;;
    ANTIGRAVITY) manifest=antigravity/plugin.json; update=update_antigravity ;;
    *) return ;;
  esac
  (
    local installed latest
    installed=$(json_field version <"$root/${manifest#*/}")
    latest=$(curl -sS -m 5 "$RELEASE_URL/platforms/$manifest" 2>/dev/null | json_field version)
    latest=${latest:-$installed}
    newer "$latest" "$installed" && eval "$update" && link_newest "$root"
  ) </dev/null >/dev/null 2>&1 &
}

cmd_session_start() {
  local root=${1:?plugin root}
  link_newest "$root"
  self_update "$root"
  local input session context=
  input=$(cat)
  session=$(json_field session_id <<<"$input")
  [[ -n $session ]] || session=$(json_field conversationId <<<"$input")
  [[ -n $session ]] && SESSION=$session
  if [[ -n $SESSION ]]; then
    local host
    host=$(host_pid)
    mkdir -p "$STATE_DIR" && printf '%s' "$SESSION" >"$STATE_DIR/host-$host.session"
    printf '%s' "$root" >"$STATE_DIR/root-$SESSION"
    rm -f "$STATE_DIR/rules-$SESSION"
    if [[ -f $TOKEN_FILE ]]; then
      local status
      status=$(call_tool status 2>/dev/null)
      if [[ $status == "You are "* ]]; then
        touch "$STATE_DIR/joined-$SESSION"
        local rules="$root/instructions.md"
        [[ -f $rules ]] || rules="$PLUGIN_ROOT/instructions.md"
        context="$(cat "$rules")"$'\n\n'"$status"
        [[ $PLATFORM == CODEX ]] && start_relay
      fi
    fi
  fi
  if [[ $PLATFORM == ANTIGRAVITY ]]; then
    if [[ -n $context ]]; then
      printf '{"injectSteps":[{"systemMessage":{"systemMessage":"%s"}}]}\n' "$(json_escape "$context")"
    else
      echo '{}'
    fi
  elif [[ -n $context ]]; then
    printf '%s\n' "$context"
  fi
}

case ${1:-} in
  login) cmd_login ;;
  logout) revoke_token; echo "Signed out" ;;
  join) shift; cmd_join "$@" ;;
  default-name) default_name; echo ;;
  topic) shift; cmd_topic "$@" ;;
  leave) shift; cmd_leave "$@" ;;
  rename) shift; cmd_rename "$@" ;;
  status) cmd_status ;;
  call) shift; need_session; args=${2:-}; [[ -n $args ]] || args='{}'; call_tool "${1:?usage: multiplayr call <tool> [json]}" "$args" ;;
  upload) shift; cmd_upload "$@" ;;
  download) shift; cmd_download "$@" ;;
  watch) cmd_watch ;;
  wait) shift; cmd_watch --once ;;
  listen) cmd_listen ;;
  state) shift; cmd_state "$@" ;;
  mcp) cmd_mcp ;;
  relay) cmd_relay ;;
  session-start) shift; cmd_session_start "$@" ;;
  # Events the hook config registers ahead of use, so a later version can act on them without a session restart.
  hook) cat >/dev/null ;;
  reload) cmd_reload ;;
  version) cmd_version ;;
  *) echo "usage: multiplayr login | logout | join <project> [name] | default-name | topic <topic> | leave <topic> | leave --project | rename <name> | status | call <tool> [json] | reload | version | hook <event> | upload <topic> <file> [text] | download <file id> <path> | watch | wait | listen | mcp | relay | session-start <plugin root>" >&2; exit 2 ;;
esac
