{
  "multiplayr": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash bin/multiplayr --platform=ANTIGRAVITY session-start"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash bin/multiplayr --platform=ANTIGRAVITY state thinking"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/multiplayr --platform=ANTIGRAVITY state thinking"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash bin/multiplayr --platform=ANTIGRAVITY state idle"
      }
    ]
  }
}
