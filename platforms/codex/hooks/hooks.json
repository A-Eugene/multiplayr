{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MULTIPLAYR_PLATFORM=CODEX \"${PLUGIN_ROOT}\"/bin/multiplayr session-start \"${PLUGIN_ROOT}\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\bin\\multiplayr.cmd\" --platform=CODEX session-start"
          }
        ]
      }
    ]
  }
}
